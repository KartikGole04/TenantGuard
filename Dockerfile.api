FROM golang:1.21-alpine AS builder

WORKDIR /app

COPY go.mod go.sum* ./
RUN go mod download

COPY api ./api
COPY . .
WORKDIR /app/api
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /tenantguard-api .

FROM alpine:3.19
WORKDIR /app
RUN apk add --no-cache ca-certificates
COPY --from=builder /tenantguard-api /tenantguard-api
EXPOSE 8080
ENTRYPOINT ["/tenantguard-api"]
